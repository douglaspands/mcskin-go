{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/command-gate.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(openspec *)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go fmt *)",
      "Bash(go mod tidy)",
      "Bash(go mod verify)",
      "Bash(make)",
      "Bash(make *)",
      "Bash(./scripts/test-compact.sh)",
      "Bash(./scripts/test-compact.sh *)",
      "Bash(./scripts/package-mac-app.sh)",
      "Bash(./scripts/run-regression-suite.sh)",
      "Bash(git add)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b feat/*)",
      "Bash(git checkout main)",
      "Bash(git pull origin main)",
      "Bash(git merge --squash *)",
      "Bash(git push origin feat/*)",
      "Bash(gh pr create *)",
      "Bash(unzip -l *)",
      "Bash(unzip -p *)",
      "Bash(rm -rf bin/)",
      "Bash(rm -rf files/*.mcpack)"
    ]
  }
}
